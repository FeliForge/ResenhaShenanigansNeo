# Copia a .env.local (local) o configura en Vercel -> Project Settings -> Environment Variables.

# --- Cliente (se inyectan en build, deben empezar con VITE_) ---
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Opcional: servidores STUN separados por coma para multijugador P2P
VITE_STUN_URLS=

# --- Servidor (runtime, NO exponer al cliente) ---
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
LOVABLE_CRON_SECRET=
